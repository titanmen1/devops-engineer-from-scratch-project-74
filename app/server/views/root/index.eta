<% layout("../layouts/application") %>
<div class="rounded border border-gray-200 bg-gray-50 p-10">
  <div class="text-4xl font-light"><%= it.t('views.welcome.index.hello') %></div>
  <p class="mt-2 text-xl text-gray-600"><%= it.t('views.welcome.index.description') %></p>
  <hr class="my-6 border-gray-300">
  <a class="inline-block rounded bg-blue-600 px-5 py-3 text-lg font-medium text-white hover:bg-blue-700" href="https://hexlet.io"><%= it.t('views.welcome.index.more') %></a>
</div>
