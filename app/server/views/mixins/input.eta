<%
  const propertyErrors = it._.get(it.errors ?? {}, it.propertyName);
  const hasError = !it._.isEmpty(propertyErrors);
  const inputId = `data_${it.propertyName}`;
%>
<div class="mb-4">
  <label class="mb-1 block font-medium" for="<%= inputId %>"><%= it.propertyName %></label>
  <input
    id="<%= inputId %>"
    name="data[<%= it.propertyName %>]"
    class="w-full rounded <%= hasError ? 'border-red-500' : 'border-gray-300' %>"
    type="<%= it.type ?? 'text' %>"
    value="<%= it._.get(it.entity, it.propertyName, '') %>"
  >
  <% if (hasError) { %>
  <div class="mt-1 text-sm text-red-600" data-test="validation-error"><%= propertyErrors.map(({ message }) => message).join('. ') %></div>
  <% } %>
</div>
