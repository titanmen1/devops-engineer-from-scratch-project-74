<% layout("../layouts/application", { header: it.t('views.articles.index.header') }) %>
<a class="mb-4 inline-block rounded bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700" href="<%= it.route('newArticle') %>"><%= it.t('views.articles.index.new') %></a>
<table class="w-full text-left">
  <thead>
    <tr>
      <th class="border-b border-gray-300 px-3 py-2"><%= it.t('views.articles.index.id') %></th>
      <th class="border-b border-gray-300 px-3 py-2"><%= it.t('views.articles.index.title') %></th>
      <th class="border-b border-gray-300 px-3 py-2"><%= it.t('views.articles.index.createdAt') %></th>
      <th class="border-b border-gray-300 px-3 py-2"><%= it.t('views.articles.index.actions') %></th>
    </tr>
  </thead>

  <tbody>
    <% it.articles.forEach((article) => { %>
    <tr class="odd:bg-gray-50">
      <td class="border-b border-gray-200 px-3 py-2"><%= article.id %></td>
      <td class="border-b border-gray-200 px-3 py-2"><%= article.title %></td>
      <td class="border-b border-gray-200 px-3 py-2"><%= it.formatDate(article.createdAt) %></td>
      <td class="border-b border-gray-200 px-3 py-2">
        <div class="flex flex-wrap items-center gap-3">
          <a class="text-blue-600 hover:underline" href="<%= it.route('article', { id: article.id }) %>"><%= it.t('layouts.actions.view') %></a>
          <a class="text-blue-600 hover:underline" href="<%= it.route('editArticle', { id: article.id }) %>"><%= it.t('layouts.actions.edit') %></a>
          <!-- удаление отправляется формой: ссылка с data-method работала на @rails/ujs, а клиентского js в приложении больше нет -->
          <%~ include("../mixins/buttonTo", {
            action: it.route('article', { id: article.id }),
            method: 'delete',
            class: 'cursor-pointer text-red-600 hover:underline',
            value: it.t('layouts.actions.delete'),
          }) %>
        </div>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
