<!doctype html>
<html lang="en">
  <head>
    <title>Hexlet Fastify Boilerplate</title>
    <link href="<%= it.assetPath('main.css') %>" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  </head>
  <body class="flex min-h-screen flex-col">
    <nav class="mb-3 bg-gray-100 px-6 py-3">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-6">
        <a class="text-lg font-semibold" href="<%= it.route('root') %>"><%= it.t('appName') %></a>
        <ul class="flex flex-wrap items-center gap-4">
          <li><a class="hover:underline" href="<%= it.route('articles') %>"><%= it.t('layouts.application.articles') %></a></li>
        </ul>
      </div>
    </nav>
    <div class="mx-auto w-full max-w-5xl grow px-4">
      <% Object.entries(it.reply.flash() || {}).forEach(([type, messages]) => { %>
        <% messages.forEach((message) => { %>
        <div class="mt-4 rounded border px-4 py-3 <%= it.getAlertClass(type) %>" role="alert"><%= message %></div>
        <% }) %>
      <% }) %>

      <h1 class="my-6 text-3xl font-bold"><%= it.header ?? '' %></h1>
      <%~ it.body %>
    </div>

    <footer>
      <div class="mx-auto my-10 max-w-5xl border-t px-4 pt-4">
        <a class="hover:underline" target="_blank" href="https://ru.hexlet.io">Hexlet</a>
      </div>
    </footer>
  </body>
</html>
