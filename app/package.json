  },
  "homepage": "https://github.com/hexlet-boilerplates/javascript-fastify-blog.git#readme",
  "dependencies": {
    "@fastify/flash": "^6.0.5",
    "@fastify/formbody": "^9.0.0",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^12.0.0",
    "@hexlet/fastify-method-override": "git+https://github.com/hexlet-components/fastify-method-override.git",
